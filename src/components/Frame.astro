---
import type { ImageMetadata } from 'astro';
import { displayHost } from '../data/projects';
import { responsiveSources } from '../utils/images';

export interface Props {
  url: string;
  image: ImageMetadata;
  alt: string;
  /** The image's rendered width per breakpoint, for srcset selection */
  sizes: string;
  /** Load straight away at high priority; only for a frame in the first screen */
  eager?: boolean;
  /** view-transition-name, so the frame carries over to the same project's frame on the next page */
  transitionName?: string | undefined;
}

// Every capture fills the frame's width; crop the capture, not the frame.
const { url, image, alt, sizes, eager = false, transitionName } = Astro.props;

const { avif, webp } = await responsiveSources(image);
---

<figure
  class="frame"
  style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
>
  <div class="frame-bar" aria-hidden="true">
    {displayHost(url)}
  </div>
  <picture>
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    <img
      src={webp.src}
      srcset={webp.srcSet.attribute}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </picture>
</figure>

<script>
  // A lazy screenshot fades in once it has loaded, inside a frame that's already there,
  // instead of popping in mid-scroll on a slow connection. Never in the first screen: eager
  // frames are skipped, and so is any frame already on screen when this runs, so the first
  // paint is never held back. On a fast connection lazy images load before they're scrolled
  // to, so there's nothing to see; that's intended.
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    for (const img of document.querySelectorAll<HTMLImageElement>('.frame img[loading="lazy"]')) {
      const frame = img.closest('.frame');
      if (!frame || img.complete) continue;
      if (frame.getBoundingClientRect().top < window.innerHeight) continue;
      frame.toggleAttribute('data-developing', true);
      const done = () => frame.removeAttribute('data-developing');
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    }
  }
</script>

<style>
  .frame {
    margin: 0;
    padding: 0 var(--space-8) var(--space-8);
    background: var(--mat);
    border: var(--border-frame);
    border-radius: var(--radius);
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    height: 32px;
    overflow: hidden;
    color: var(--text-2);
    font-family: var(--mono);
    font-size: var(--text-frame);
    letter-spacing: var(--tracking-frame);
    white-space: nowrap;
  }

  /* The three browser dots, drawn rather than marked up */
  .frame-bar::before {
    content: '';
    flex: none;
    width: 34px;
    height: 8px;
    background: radial-gradient(circle at 4px 4px, var(--mat-edge) 3.5px, transparent 4px) 0 0 /
      13px 8px repeat-x;
  }

  .frame :global(img) {
    width: 100%;
    transition: opacity var(--duration-develop) var(--ease-out);
  }

  .frame[data-developing] :global(img) {
    opacity: 0;
  }
</style>
