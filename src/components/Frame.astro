---
import type { ImageMetadata } from 'astro';
import { displayHost } from '../data/projects';
import { responsiveSources } from '../utils/images';

export interface Props {
  url: string;
  image: ImageMetadata;
  alt: string;
  /** The image's rendered width per breakpoint, for srcset selection */
  sizes: string;
  /** Load straight away at high priority; only for a frame in the first screen */
  eager?: boolean;
}

const { url, image, alt, eager = false } = Astro.props;

// Portrait captures (app UIs) are capped at 400px and centred; the frame never shrinks to fit.
const tall = image.height > image.width;
const sizes = tall ? '(max-width: 480px) calc(100vw - 50px), 400px' : Astro.props.sizes;

const { avif, webp } = await responsiveSources(image);
---

<figure class:list={['frame', { tall }]}>
  <div class="frame-bar" aria-hidden="true">
    {displayHost(url)}
  </div>
  <picture>
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    <img
      src={webp.src}
      srcset={webp.srcSet.attribute}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </picture>
</figure>

<style>
  .frame {
    margin: 0;
    padding: 0 var(--space-8) var(--space-8);
    background: var(--mat);
    border: var(--border-frame);
    border-radius: var(--radius);
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    height: 32px;
    overflow: hidden;
    color: var(--text-2);
    font-family: var(--mono);
    font-size: var(--text-frame);
    letter-spacing: var(--tracking-frame);
    white-space: nowrap;
  }

  /* The three browser dots, drawn rather than marked up */
  .frame-bar::before {
    content: '';
    flex: none;
    width: 34px;
    height: 8px;
    background: radial-gradient(circle at 4px 4px, var(--mat-edge) 3.5px, transparent 4px) 0 0 /
      13px 8px repeat-x;
  }

  .frame :global(img) {
    width: 100%;
  }

  .tall :global(img) {
    max-width: 400px;
    margin: 0 auto;
  }
</style>
