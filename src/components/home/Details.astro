---
import SpecList from '../SpecList.astro';
import { priceRows } from '../../data/packages';
import { replyPromise, serviceAreas } from '../../data/site';

const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);

// Two separate lists, never interleaved: prices first, then how the work runs.
const logistics = [
  { label: 'Replies', value: sentence(replyPromise) },
  { label: 'In person', value: serviceAreas.inPerson },
  { label: 'Remote', value: serviceAreas.remote },
  { label: 'Stack', value: 'TypeScript · React · CSS' },
];
---

<div class="specs">
  <SpecList label="Prices" rows={priceRows} />
  <SpecList label="How I work" rows={logistics} />
</div>

<style>
  .specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-64);
  }

  @media (max-width: 860px) {
    .specs {
      grid-template-columns: 1fr;
    }
  }
</style>
