---
import { process } from '../../data/process';
---

<ol class="steps">
  {process.map((step, i) => (
    <li>
      <span class="n mono" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3>{step.name}</h3>
      <p>{step.detail}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    /* Same columns as the project rows, so the details line up with the frames above */
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8) var(--space-40);
    align-items: baseline;
    padding: var(--space-20) 0 var(--space-24);
    border-top: var(--border);
  }

  .n {
    color: var(--text-3);
  }

  h3 {
    margin: 0;
    font-size: var(--text-lede);
    font-weight: var(--weight-medium);
    line-height: var(--leading-lede);
  }

  p {
    margin: 0;
    max-width: 52ch;
    color: var(--text-2);
  }

  @media (max-width: 860px) {
    li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    p {
      grid-column: 2;
    }
  }
</style>
