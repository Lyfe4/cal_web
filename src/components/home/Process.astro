---
import { process } from '../../data/process';
---

<ol class="steps">
  {process.map((step, i) => (
    <li>
      <span class="n mono" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3>{step.name}</h3>
      <p>{step.detail}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    /* Same columns as the project rows, so the details line up with the frames above */
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8) var(--space-40);
    align-items: baseline;
    padding: var(--space-20) 0 var(--space-24);
    border-top: var(--border);
  }

  .n {
    color: var(--text-3);
  }

  h3 {
    margin: 0;
    font-size: var(--text-lede);
    font-weight: var(--weight-medium);
    line-height: var(--leading-lede);
  }

  p {
    margin: 0;
    max-width: 52ch;
    color: var(--text-2);
  }

  /* Reading progress: as each step comes up the screen its rule draws across in --text-3
     and its number brightens, so the steps you've read stay marked. Scrolling back up
     undoes it. Scroll-driven, no script; without support (Firefox) it's the plain list. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      li::before {
        content: '';
        position: absolute;
        top: -1px;
        right: 0;
        left: 0;
        height: 1px;
        background: var(--text-3);
        transform-origin: left;
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 100% cover 45%;
      }

      .n {
        animation: brighten linear both;
        animation-timeline: view();
        animation-range: cover 35% cover 45%;
      }
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes brighten {
    to {
      color: var(--text);
    }
  }

  @media (max-width: 860px) {
    li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    p {
      grid-column: 2;
    }
  }
</style>
