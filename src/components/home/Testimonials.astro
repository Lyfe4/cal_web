---
import { splitLead, type Testimonial } from '../../data/testimonials';

export interface Props {
  testimonials: Testimonial[];
  /** Link each quote to its case study; off on the case study itself */
  linkProject?: boolean;
}

const { testimonials, linkProject = true } = Astro.props;
---

<ul class="quotes">
  {testimonials.map(({ quote, name, from, source, rating, project }) => {
    const { lead, rest } = splitLead(quote);
    return (
      <li>
        <figure>
          <blockquote cite={source.href}>
            <p class="lead">{lead}</p>
            {rest && <p class="rest">{rest}</p>}
          </blockquote>
          <figcaption class="mono">
            <span class="name">{name}</span>
            <span>{from}</span>
            {rating && (
              <span>
                {rating.value} / {rating.max} on Google
              </span>
            )}
            <a href={source.href}>{source.label}</a>
            {linkProject && project && <a href={`/work/${project}`}>See the project</a>}
          </figcaption>
        </figure>
      </li>
    );
  })}
</ul>

<style>
  .quotes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: var(--space-56);
  }

  figure,
  blockquote {
    margin: 0;
  }

  /* The opening sentence carries the statement size; the rest reads at lede size */
  .lead {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-feature);
    font-weight: var(--weight-hero);
    line-height: var(--leading-feature);
    letter-spacing: var(--tracking-feature);
  }

  /* Quotation marks: typographic “ ” in --text-3, added here so the stored quote stays word
     for word. The "/ ''" alt text keeps screen readers from reading them out; the
     blockquote already says it's a quote. No animation: punctuation doesn't move. */
  .lead::before {
    content: '\201C';
    content: '\201C' / '';
    color: var(--text-3);
  }

  /* The closing mark ends the last paragraph, at that paragraph's size */
  blockquote > p:last-child::after {
    content: '\201D';
    content: '\201D' / '';
    color: var(--text-3);
  }

  /* Hanging punctuation where the margin has room for it: the opening mark sits outside the
     column and the first line's text lines up with the lines below. The hang is the mark's
     advance in Geist at weight 480 (0.393em, measured) plus the statement's tracking.
     Narrower windows keep it inline. */
  @media (min-width: 1320px) {
    .lead {
      text-indent: calc(-0.393em - var(--tracking-feature));
    }
  }

  .rest {
    margin: var(--space-28) 0 0;
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--text-lede);
    line-height: var(--leading-lede);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin-top: var(--space-24);
    color: var(--text-3);
  }

  .name {
    color: var(--text);
  }

  figcaption a {
    color: var(--text-2);
    text-underline-offset: 0.2em;
  }

  figcaption a:hover {
    color: var(--text);
  }
</style>
