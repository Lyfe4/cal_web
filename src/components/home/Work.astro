---
import FeaturedProject from '../FeaturedProject.astro';
import Frame from '../Frame.astro';
import Status from '../Status.astro';
import { displayHost, projectPath, type Project } from '../../data/projects';

export interface Props {
  projects: Project[];
}

const [featured, ...rest] = Astro.props.projects;
---

{featured && (
  <div class="featured">
    <FeaturedProject project={featured} eager />
  </div>
)}

<ol class="projects">
  {rest.map((project) => (
    <li>
      <span class="n mono" aria-hidden="true">
        {String(project.data.order).padStart(2, '0')}
      </span>
      <div>
        <h3 id={`p-${project.data.slug}`} style={`view-transition-name: name-${project.data.slug}`}>
          <a href={projectPath(project)}>{project.data.name}</a>
        </h3>
        <p class="desc">{project.data.summary}</p>
        <p class="facts mono">
          <span>{project.data.type}</span>
          {project.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
          <Status status={project.data.status} />
        </p>
        {project.data.upNext && <p class="up-next">{project.data.upNext}</p>}
        <p class="live mono">
          <a href={project.data.url}>{displayHost(project.data.url)}</a>
        </p>
      </div>
      <Frame
        url={project.data.url}
        image={project.data.screenshot.src}
        mobile={project.data.screenshot.mobile}
        alt={project.data.screenshot.alt}
        sizes="(max-width: 860px) calc(100vw - 2 * clamp(16px, 3vw, 40px) - 18px), (max-width: 1280px) 38vw, 514px"
        transitionName={`frame-${project.data.slug}`}
      />
    </li>
  ))}
</ol>

<style>
  .featured {
    padding-bottom: var(--space-56);
  }

  /* Other projects: large names */
  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-16) var(--space-40);
    align-items: start;
    padding: var(--space-32) 0 var(--space-40);
    border-top: var(--border);
  }

  .n {
    padding-top: 14px;
    color: var(--text-3);
  }

  .projects h3 {
    /* Shrink to the name, so the view transition morphs the words and not the column */
    width: fit-content;
    margin: 0 0 var(--space-20);
    font-size: var(--text-project);
    font-weight: var(--weight-medium);
    line-height: var(--leading-project);
    letter-spacing: var(--tracking-project);
  }

  .projects h3 a {
    text-decoration: none;
    transition:
      font-weight var(--duration) var(--ease-out),
      letter-spacing var(--duration) var(--ease-out);
  }

  /* The name firms up under the pointer: Geist's weight axis goes to 560, and tighter
     tracking pays back the width the heavier strokes add, so the line never rewraps */
  .projects h3 a:hover,
  .projects h3 a:focus-visible {
    font-weight: var(--weight-wordmark);
    letter-spacing: var(--tracking-project-firm);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .projects .desc {
    margin: 0 0 var(--space-16);
    max-width: 44ch;
    color: var(--text-2);
    font-size: var(--text-desc);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin: 0;
    color: var(--text-3);
  }

  .up-next {
    margin: var(--space-12) 0 0;
    color: var(--text-2);
    font-size: var(--text-ui);
  }

  /* URLs stay lowercase, like the frame bar */
  .live {
    margin: var(--space-12) 0 0;
    text-transform: none;
  }

  .live a {
    color: var(--text-2);
    text-underline-offset: 0.2em;
  }

  .live a:hover {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .projects li {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-12);
      padding: var(--space-24) 0 var(--space-32);
    }

    .n {
      padding-top: 0;
    }
  }

  /* Stacked, the featured project ends on its facts table, whose last row the first project
     row's rule closes; the space under the featured project moves below that rule (global.css,
     "One line where a ruled list ends a block") */
  @media (max-width: 860px) {
    .featured {
      padding-bottom: 0;
    }

    .featured + .projects li:first-child {
      padding-top: calc(var(--space-24) + var(--space-56));
    }
  }

  @media (max-width: 480px) {
    .featured + .projects li:first-child {
      padding-top: calc(var(--space-24) + var(--space-40));
    }
  }
</style>
