---
import { person } from '../../data/site';
---

<div class="about">
  <p>
    <strong>I'm {person.firstName}.</strong> I studied computer science at UNE and have worked
    <span class="nowrap">in-house</span> as a frontend developer on production web apps. Now I build
    for businesses directly: you deal with me from the first call to launch and after, with no
    agency in between.
  </p>
  <a class="btn btn-ghost" href="/about">
    More about me <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-28) var(--space-64);
    align-items: end;
  }

  p {
    margin: 0;
    max-width: 46ch;
    color: var(--text-2);
    font-size: var(--text-lede);
    line-height: var(--leading-lede);
  }

  /* Keep the hyphenated word on one line */
  .nowrap {
    white-space: nowrap;
  }

  strong {
    color: var(--text);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .btn {
      justify-self: start;
    }
  }
</style>
