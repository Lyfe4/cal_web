---
import type { Project } from '../data/projects';

export interface Props {
  status: Project['data']['status'];
}

const { status } = Astro.props;
const label = status === 'live' ? 'Live' : 'In progress';
---

<span class:list={{ wip: status === 'in progress' }} data-status>
  <span class="dot"></span>
  {label}
</span>

<script>
  // Marks each status the first time it's on screen, so its dot animates where it can be
  // seen (styles in global.css). Nothing is hidden without this; the dot just stays still.
  const statuses = document.querySelectorAll('[data-status]');
  const moving = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (moving && statuses.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.toggleAttribute('data-seen', true);
          observer.unobserve(entry.target);
        }
      },
      // Wait until it's a little way up the screen, not just touching the bottom edge
      { rootMargin: '0px 0px -15% 0px' }
    );
    statuses.forEach((status) => observer.observe(status));
  }
</script>
