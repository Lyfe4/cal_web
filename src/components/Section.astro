---
export interface Props {
  /** Anchor id; the heading gets `${id}-h` */
  id: string;
  /** Position on the page, shown as "01"; left out for closing sections like Contact */
  n?: number | undefined;
  title: string;
  /** Quiet note on the right of the head; hidden under 860px */
  note?: string | undefined;
  /** Names the section's scroll-driven view timeline, e.g. for a page's section map */
  timeline?: string | undefined;
  /** The section ends on a ruled list in two columns too, not just in one, so the list's
      closing rule is the next section's rule on desktop as well (see global.css). "wide"
      when that's only true in two columns, e.g. the list is the tallest column but not the
      last thing in the markup */
  ruledEnd?: boolean | 'wide';
}

const { id, n, title, note, timeline, ruledEnd = false } = Astro.props;
const heading = n === undefined ? title : `${String(n).padStart(2, '0')} / ${title}`;
---

<section
  class="sec"
  id={id}
  aria-labelledby={`${id}-h`}
  data-ruled-end={ruledEnd === 'wide' ? 'wide' : ruledEnd ? 'all' : undefined}
  style={timeline ? `view-timeline-name: ${timeline}` : undefined}
>
  <div class="sec-head mono">
    <h2 id={`${id}-h`}>{heading}</h2>
    {note && <span>{note}</span>}
  </div>
  <slot />
</section>

<style>
  .sec {
    padding: var(--space-20) 0 var(--space-section-end);
    border-top: var(--border);
    scroll-margin-top: var(--space-16);
  }

  .sec-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-16);
    margin-bottom: var(--space-28);
    color: var(--text-3);
  }

  h2 {
    margin: 0;
    font: inherit;
  }

  @media (max-width: 860px) {
    .sec-head span {
      display: none;
    }
  }

  /* Phones: less air at the end of each section (--space-section-end drops to 48px), so the
     page reads as one run of content rather than blocks separated by empty screens */
  @media (max-width: 480px) {
    .sec-head {
      margin-bottom: var(--space-20);
    }
  }
</style>
