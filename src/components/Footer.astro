---
import { areaLinks } from '../data/areas';
import { business, formattedAddress } from '../data/site';
---

<footer class="foot">
  <div class="wrap foot-grid">
    <div class="foot-main">
      <p class="ack">
        I live and work in Armidale on Aboriginal land. I acknowledge the Traditional Custodians of
        the New England region and pay my respects to Elders past and present.
      </p>
      <nav class="areas mono" aria-labelledby="areas-h">
        <h2 id="areas-h">Areas</h2>
        <ul>
          {areaLinks.map((area) => (
            <li>
              <a href={area.href}>{area.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <address class="foot-meta mono">
      <span>
        {business.name} · {formattedAddress}
      </span>
      <a href={business.phone.href}>{business.phone.display}</a>
      <a class="email" href={`mailto:${business.email}`}>
        {business.email}
      </a>
      <span>ABN {business.abn}</span>
    </address>
  </div>
</footer>

<style>
  .foot {
    padding: var(--space-40) 0 var(--space-48);
    border-top: var(--border);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-32) var(--space-64);
  }

  .ack {
    margin: 0;
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--text-ui);
  }

  .areas {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-8) var(--space-24);
    margin-top: var(--space-32);
    color: var(--text-3);
  }

  .areas h2 {
    margin: 0;
    font: inherit;
  }

  .areas ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .areas a {
    color: var(--text-2);
    text-underline-offset: 0.2em;
  }

  .areas a:hover {
    color: var(--text);
  }

  .foot-meta {
    display: grid;
    gap: var(--space-8);
    justify-items: end;
    color: var(--text-3);
    font-style: normal;
    text-align: right;
  }

  /* Addresses stay lowercase so they read as typed */
  .email {
    text-transform: none;
  }

  @media (max-width: 860px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }

    .foot-meta {
      justify-items: start;
      text-align: left;
    }
  }
</style>
