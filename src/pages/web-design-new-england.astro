---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import LocalServices from '../components/LocalServices.astro';
import ContactCta from '../components/home/ContactCta.astro';
import Testimonials from '../components/home/Testimonials.astro';
import { localPageSchema, localPages } from '../data/areas';
import { getProjects } from '../data/projects';
import { formatPrice, newEnglandTowns, pricing, serviceAreas } from '../data/site';
import { testimonials } from '../data/testimonials';

const page = localPages.newEngland;
const lenbuild = (await getProjects()).find((p) => p.data.slug === 'lenbuild');
if (!lenbuild) throw new Error('The New England page needs LenBuild');
const kindWords = testimonials.filter((t) => t.project === 'lenbuild');

// Towns with a page of their own link to it
const townPages: Partial<Record<string, string>> = {
  [localPages.armidale.name]: localPages.armidale.href,
  [localPages.tamworth.name]: localPages.tamworth.href,
};
const townNotes: Partial<Record<string, string>> = {
  Armidale: 'Where I live and work',
  Guyra: 'Home of LenBuild',
};

const n = (id: string) =>
  ['towns', 'client', 'said', 'services']
    .filter((s) => s !== 'said' || kindWords.length > 0)
    .indexOf(id) + 1;
---

<BaseLayout title={page.title} description={page.description} schema={localPageSchema(page)}>
  <div class="wrap">
    <PageHead
      title={page.heading}
      meta={[
        'Based in Armidale, NSW',
        `In person ${serviceAreas.inPerson}`,
        `Phone, video and email ${serviceAreas.remote}`,
      ]}
    >
      <strong>I build websites and web apps for businesses across New England,</strong> from my base
      in Armidale. Small-business websites start at {formatPrice(pricing.starter.from)}, and app
      work is quoted per project.
      <Fragment slot="aside">
        <a class="btn btn-primary" href="/contact">
          Get a quote <span aria-hidden="true">→</span>
        </a>
      </Fragment>
    </PageHead>

    <Section
      id="towns"
      n={n('towns')}
      title="Where I work"
      note={`${newEnglandTowns.length} towns`}
    >
      <div class="towns">
        <div class="prose">
          <p>
            I'm based in Armidale and meet clients in person in and around Armidale, Guyra and
            Uralla. If you're further away, you're welcome to meet me in Armidale.
          </p>
          <p>
            I work with businesses in the other towns on this list by phone, video and email, and in
            person by arrangement.
          </p>
          <p>
            Wherever you are, the work runs the same way: a first call or chat about what you need,
            a written quote before anything starts, then email and phone, whichever suits you, with
            a private preview link so you can see the site come together.
          </p>
          <p>
            Outside the region, I work by phone, video and email with businesses anywhere in
            Australia.
          </p>
        </div>
        <ul class="town-list" aria-label="Towns I work with">
          {newEnglandTowns.map((town) => {
            const href = townPages[town];
            const note = townNotes[town];
            return (
              <li>
                {href ? <a href={href}>{town}</a> : <span class="town">{town}</span>}
                {note && <span class="mono">{note}</span>}
              </li>
            );
          })}
        </ul>
      </div>
    </Section>

    <Section id="client" n={n('client')} title="A New England client" note="Guyra, NSW">
      <FeaturedProject project={lenbuild}>
        <p>
          A family-run building company in Guyra. They build custom homes, extensions and
          renovations across New England, and had no website before this, so I built one from
          scratch.
        </p>
        <p>
          Six pages, including two local ones: custom homes in Guyra, and builders in Armidale.
          Every page tells search engines what LenBuild does and the areas it serves.
        </p>
      </FeaturedProject>
    </Section>

    {kindWords.length > 0 && (
      <Section id="said" n={n('said')} title="What they said">
        <Testimonials testimonials={kindWords} linkProject={false} />
      </Section>
    )}

    <Section id="services" n={n('services')} title="Services and prices" note="Prices in AUD">
      <LocalServices>
        A website for a business like LenBuild, or frontend work on a web app or integration.
        Websites have fixed starting prices; the rest is quoted once I know what it involves.
      </LocalServices>
    </Section>

    <Section id="contact" title="Contact">
      <ContactCta
        statement="Running a business in New England?"
        lede="Tell me what you do, where you are and what you need from a website."
      />
    </Section>
  </div>
</BaseLayout>

<style>
  .towns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-40) var(--space-64);
    align-items: start;
  }

  .prose {
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--text-desc);
  }

  .prose p {
    margin: 0 0 var(--space-16);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  /* Town names on 1px rules, a note in mono on the right where there's something real to say */
  .town-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: var(--border);
  }

  .town-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-16);
    padding: 11px 0;
    border-top: var(--border);
    font-size: var(--text-desc);
  }

  .town-list a {
    text-underline-offset: 0.2em;
  }

  .town-list .mono {
    color: var(--text-3);
    text-align: right;
  }

  @media (max-width: 860px) {
    .towns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
